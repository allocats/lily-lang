calloc        :: foreign fn(size: usize) -> *void;
malloc        :: foreign fn(size: usize) -> *void;
realloc       :: foreign fn(ptr: *void, size: usize) -> *void;
aligned_alloc :: foreign fn(alignment: usize, size: usize) -> *void;

free :: foreign fn(ptr: *void);

memset  :: intrinsic fn(dest: *void, byte: i8,   size: isize);
memcpy  :: intrinsic fn(dest: *void, src: *void, size: isize);
memmove :: intrinsic fn(dest: *void, src: *void, size: isize);
