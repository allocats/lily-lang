malloc        :: foreign fn(size_in_bytes: usize) -> *void;
realloc       :: foreign fn(ptr: *void, size_in_bytes: usize) -> *void;
calloc        :: foreign fn(number_of_elements: usize, element_size_in_bytes: usize) -> *void;
aligned_alloc :: foreign fn(alignment: usize, size_in_bytes: usize) -> *void;

free :: foreign fn(ptr: *void);

memcmp :: foreign fn(ptr_a: *void, ptr_b: *void, size_in_bytes: isize) -> i32;
